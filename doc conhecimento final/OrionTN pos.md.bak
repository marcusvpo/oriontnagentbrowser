  - "Como criar um serviço com valor variável?"
  - "Onde adiciono outros serviços no caixa?"
  - "Como definir um serviço com valor fixo?"
video:
  tem_video: true
  bunny_library_id: "467408"
  bunny_video_id: "78f4e964-21e1-4aa4-83ad-b974bc0efa36"
