# Configuração de Ambiente para Auditoria de Homologação Orion TN
# Copie este arquivo para `auditoria/.env` e preencha os valores reais.
ORION_HOMOLOG_URL=http://<IP>:<PORT>/webPortal/#/login
ORION_APP_HOME_URL=http://<IP>:<PORT>/webFirmas/#/inicio
ORION_USER=<USUARIO_HOMOLOGACAO>
ORION_PASS="<SENHA_HOMOLOGACAO>"

# Configurações do Navegador
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
BROWSER_TIMEOUT_MS=20000
ORION_DRY_RUN_MUTATIONS=true

# Opcional: fallback LLM para Auto-Cura (Camada 2B) e Exploração Investigativa
OPENAI_API_KEY=

# Supabase (Backend API / Pooler PostgreSQL / Storage)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
SUPABASE_SECRET_KEY=<SUPABASE_SECRET_KEY>
SUPABASE_DB_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_STORAGE_BUCKET=audit-screenshots

# Servidor Local (Orion Audit Console API)
API_PORT=3333
API_HOST=0.0.0.0
