{
  "name": "orion-auditoria-agent-browser",
  "version": "1.0.0",
  "description": "Pipeline de auditoria, validação e enriquecimento visual das rotinas do Orion TN via agent-browser e Sharp",
  "type": "module",
  "scripts": {
    "server": "tsx src/server.ts",
    "supabase:migrate": "tsx src/migrate-supabase.ts",
    "supabase:sync": "tsx src/sync-supabase.ts",
    "audit": "tsx src/cli.ts",
    "test": "tsx --test \"src/__tests__/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:annotator": "tsx src/test-annotator.ts",
    "test:parser": "tsx src/parser.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "agent-browser": "^0.42.0",
    "dotenv": "^16.4.7",
    "pg": "^8.23.1",
    "sharp": "^0.33.5",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
