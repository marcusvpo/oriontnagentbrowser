{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": ".repomix-output/02b-motor-operacao.md",
    "style": "markdown",
    "headerText": "ORION TN - Super-Contexto (Parte 3/5): operacao do motor de auditoria (API server, MCP, sync Supabase, invariantes, relatorio, CLI, exportadores, daemon, worker pool, RAG de revisoes, consultor [ATT], Firmas, seed de revisoes) + contratos (types.ts, phase3-types.ts) e migrations SQL. Nucleo na Parte 2/5; periferia e scripts na Parte 4/5. Fonte: GitHub marcusvpo/oriontnagentbrowser (branch main).",
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "showLineNumbers": false
  },
  "include": [
    "auditoria/src/server.ts",
    "auditoria/src/mcp-server.ts",
    "auditoria/src/sync-supabase.ts",
    "auditoria/src/invariants.ts",
    "auditoria/src/att-screen-advisor.ts",
    "auditoria/src/human-review-rag.ts",
    "auditoria/src/report.ts",
    "auditoria/src/firmas-interactive.ts",
    "auditoria/src/cli.ts",
    "auditoria/src/exporters.ts",
    "auditoria/src/verify-all-phase2-boxes.ts",
    "auditoria/src/worker-daemon.ts",
    "auditoria/src/worker-pool.ts",
    "auditoria/src/evidence.ts",
    "auditoria/src/step-scope.ts",
    "auditoria/src/supabase.ts",
    "auditoria/src/seed-human-reviews.ts",
    "auditoria/src/types.ts",
    "auditoria/src/manifests/phase3-types.ts",
    "auditoria/supabase/**/*.sql"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.repomix-output/**",
      "auditoria/rotinas/**",
      "auditoria/backup/**",
      "auditoria/backups/**",
      "auditoria/cache/**",
      "auditoria/auth/**",
      "auditoria/exports/**",
      "auditoria/design system/**",
      "kb/**",
      "rotinas/**",
      "doc conhecimento final/**",
      "novas transcricoes/**",
      "novos contextos/**",
      "orion-tn-tickets/**",
      "testes playground/**",
      "timestamp/**",
      "transcricoes que estavam faltando/**",
      "txts brutos/**",
      "**/*_corrigido.md",
      "OrionTN.md",
      "SUPER_PROMPT_BASE_CONHECIMENTO_ORION_REG.md",
      "**/__pycache__/**",
      "**/.venv/**",
      "**/*.pyc",
      "**/package-lock.json",
      "**/bun.lock",
      "**/*.webp",
      "**/*.png",
      "**/*.jpg",
      "**/*.ico",
      "**/*.pdf",
      "**/*.zip"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
