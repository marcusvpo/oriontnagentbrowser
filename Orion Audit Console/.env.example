# ==============================================================================
# Orion Audit Console — Configuração de Ambiente (Local e Vercel)
# ==============================================================================
# Copie este arquivo para `Orion Audit Console/.env` para uso local.
# Na Vercel (Settings -> Environment Variables), configure estas chaves no projeto `orionaudit`.

# --- FRONTEND (expostas no navegador — prefixo VITE_) ---
# Em produção (Vercel) o padrão já é false; use true apenas para testes offline com dados simulados.
VITE_USE_MOCK=false

# Local: http://localhost:3333
# Vercel (Produção): deixe VAZIO ou não defina — o app chama `/api/*` no próprio domínio automaticamente.
VITE_API_BASE_URL=http://localhost:3333

# Supabase Realtime (atualização ao vivo entre todos os revisores)
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>

# --- BACKEND SERVERLESS NA VERCEL (privadas — NUNCA use prefixo VITE_) ---
# Obrigatórias na Vercel para as rotas `/api/*` lerem/gravarem no Supabase respeitando o RLS.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SECRET_KEY=<SUPABASE_SECRET_KEY>
SUPABASE_STORAGE_BUCKET=audit-screenshots
