{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": ".repomix-output/01-memoria-e-contratos.md",
    "style": "markdown",
    "headerText": "ORION TN - Super-Contexto (Parte 1/5): Memoria Viva exclusiva (CLAUDE.md, ADRs, padroes, skills). Contratos de tipos e migrations SQL estao na Parte 3/5. GEMINI.md (espelho do CLAUDE.md) fica fora dos pacotes. Fonte: GitHub marcusvpo/oriontnagentbrowser (branch main).",
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "showLineNumbers": false
  },
  "include": [
    "CLAUDE.md",
    ".agents/memory/**/*.md",
    ".agents/skills/**/*.md",
    "auditoria/tsconfig.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".agents/memory/README.md",
      ".agents/memory/standards/design_system_siplan.md",
      ".agents/memory/standards/guia_comandos_claude_antigravity.md",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.repomix-output/**",
      "auditoria/rotinas/**",
      "auditoria/backup/**",
      "auditoria/backups/**",
      "auditoria/cache/**",
      "auditoria/auth/**",
      "auditoria/exports/**",
      "auditoria/design system/**",
      "kb/**",
      "rotinas/**",
      "doc conhecimento final/**",
      "novas transcricoes/**",
      "novos contextos/**",
      "orion-tn-tickets/**",
      "testes playground/**",
      "timestamp/**",
      "transcricoes que estavam faltando/**",
      "txts brutos/**",
      "**/*_corrigido.md",
      "OrionTN.md",
      "SUPER_PROMPT_BASE_CONHECIMENTO_ORION_REG.md",
      "**/__pycache__/**",
      "**/.venv/**",
      "**/*.pyc",
      "**/package-lock.json",
      "**/bun.lock",
      "**/*.webp",
      "**/*.png",
      "**/*.jpg",
      "**/*.ico",
      "**/*.pdf",
      "**/*.zip"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
