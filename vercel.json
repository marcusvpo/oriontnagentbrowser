{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev && npm install --prefix \"Orion Audit Console\"",
  "buildCommand": "npm run build --prefix \"Orion Audit Console\"",
  "outputDirectory": "Orion Audit Console/dist/client",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
