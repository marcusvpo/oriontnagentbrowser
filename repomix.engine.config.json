{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": ".repomix-output/02a-motor-nucleo.md",
    "style": "markdown",
    "headerText": "ORION TN - Super-Contexto (Parte 2/4): nucleo do motor de auditoria (auditoria/src: executor, SmartLocator, geometria DOM, browser, menu, RBAC, relatorio, anotador, sessao, worker pool, CLI). A periferia do motor esta na Parte 3/4. Fonte: GitHub marcusvpo/oriontnagentbrowser (branch main).",
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "showLineNumbers": false
  },
  "include": [
    "auditoria/src/executor.ts",
    "auditoria/src/smart-locator.ts",
    "auditoria/src/run-phase2-master.ts",
    "auditoria/src/dom-geometry.ts",
    "auditoria/src/browser.ts",
    "auditoria/src/menu-path.ts",
    "auditoria/src/reveal-explorer.ts",
    "auditoria/src/stateful-step-engine.ts",
    "auditoria/src/rbac.ts",
    "auditoria/src/report.ts",
    "auditoria/src/annotator.ts",
    "auditoria/src/auth.ts",
    "auditoria/src/worker-pool.ts",
    "auditoria/src/evidence.ts",
    "auditoria/src/step-scope.ts",
    "auditoria/src/navigation-guard.ts",
    "auditoria/src/semantic-compatibility.ts",
    "auditoria/src/cli.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.repomix-output/**",
      "auditoria/rotinas/**",
      "auditoria/backup/**",
      "auditoria/backups/**",
      "auditoria/cache/**",
      "auditoria/auth/**",
      "auditoria/exports/**",
      "auditoria/design system/**",
      "kb/**",
      "rotinas/**",
      "doc conhecimento final/**",
      "novas transcricoes/**",
      "novos contextos/**",
      "orion-tn-tickets/**",
      "testes playground/**",
      "timestamp/**",
      "transcricoes que estavam faltando/**",
      "txts brutos/**",
      "**/*_corrigido.md",
      "OrionTN.md",
      "SUPER_PROMPT_BASE_CONHECIMENTO_ORION_REG.md",
      "**/__pycache__/**",
      "**/.venv/**",
      "**/*.pyc",
      "**/package-lock.json",
      "**/bun.lock",
      "**/*.webp",
      "**/*.png",
      "**/*.jpg",
      "**/*.ico",
      "**/*.pdf",
      "**/*.zip"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
