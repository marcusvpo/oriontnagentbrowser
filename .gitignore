# ==============================================================================
# Orion TN & Orion Audit Console — .gitignore Blindado (Segurança + Binários)
# ==============================================================================

# 1. Autenticação, sessões, cookies e tokens WildFly SSO
auditoria/auth/
session-*.json

# 2. Variáveis de ambiente e segredos (libera apenas os templates .env.example)
.env
.env.*
!.env.example

# 3. Dependências, caches de ferramentas e builds
node_modules/
dist/
build/
.tanstack/
.wrangler/
Orion Audit Console/src/.generated/
*.log
npm-debug.log*
__pycache__/
*.pyc

# 4. Backups, caches e saídas temporárias do motor de auditoria
auditoria/backups/
auditoria/cache/
auditoria/test-output/*.png

# 5. Prints PNG pesados ficam apenas localmente (versionar *-revisado.md e .webp)
auditoria/rotinas/**/*.png

# 6. Sistema operacional / editores
.DS_Store
Thumbs.db
