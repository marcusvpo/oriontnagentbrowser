# ==============================================================================
# Super-Contexto Orion TN -> Google Drive / NotebookLM (ADR-034)
# Template com PLACEHOLDERS. Copie para `.env` (ignorado pelo Git) apenas para rodar
# `npm run sync:notebook` localmente. No GitHub Actions, estes valores vem de
# Repository Secrets com os mesmos nomes. Nunca commite valores reais.
# ==============================================================================

# JSON completo da Service Account (uma linha). Alternativa local: GOOGLE_APPLICATION_CREDENTIALS.
GDRIVE_SERVICE_ACCOUNT_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# IDs dos 5 Google Docs nativos pre-existentes (compartilhados como Editor com a Service Account).
GDRIVE_FILE_ID_MEMORY=
GDRIVE_FILE_ID_ENGINE=
GDRIVE_FILE_ID_ENGINE_2=
GDRIVE_FILE_ID_ENGINE_3=
GDRIVE_FILE_ID_CONSOLE=

# Opcional: MIME de upload (padrao text/markdown; fallback automatico para text/plain).
# GDRIVE_UPLOAD_MIME=text/markdown
